# Используем официальный образ Java Runtime Environment (JRE)
# Выберите подходящую версию Java в зависимости от вашего проекта.
# Поскольку в pom.xml указана java.version 17, используем образ на основе Java 17.
FROM openjdk:17

# Устанавливаем рабочую директорию в контейнере
WORKDIR /app

# Копируем собранный JAR-файл в контейнер.
# Предполагается, что JAR-файл находится в target/ вашего проекта.
COPY target/WebQuest.jar app.jar

# Открываем порт, на котором работает Spring Boot (обычно 8080)
EXPOSE 8080

# Команда для запуска приложения.
# Используем java -jar для запуска исполняемого JAR-файла.
ENTRYPOINT ["java", "-jar", "app.jar"]